{
  "name": "@portfolio/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend del portfolio: API REST con Express y SQLite",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:better-sqlite3",
    "start": "node dist/server.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "db:messages": "tsx scripts/messages.ts"
  },
  "dependencies": {
    "@portfolio/shared": "*",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
