# Copia este archivo como `.env.local` y ajusta los valores que necesites.
# Todos tienen un valor por defecto razonable: la app arranca sin configurar nada.

# --- Servidor ---------------------------------------------------------------
# Ruta del fichero SQLite (relativa a la raíz del proyecto o absoluta).
DATABASE_PATH=data/portfolio.db

# Límite de envíos del formulario de contacto por IP.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# --- Público (se incluye en el bundle del cliente) --------------------------
# URL pública del sitio; se usa como base de los metadatos Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identidad: perfiles y email de contacto que se muestran en la web.
NEXT_PUBLIC_GITHUB_USER=EasyFeliu
NEXT_PUBLIC_LINKEDIN_USER=luisfeliu
NEXT_PUBLIC_CONTACT_EMAIL=hola@luisfeliu.dev
