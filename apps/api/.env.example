# Backend (apps/api). Copia este archivo como `.env.local`… o no: todos los
# valores tienen un defecto razonable y la API arranca sin configurar nada.

# Puerto y host donde escucha la API.
PORT=4000
HOST=0.0.0.0

# Ruta del fichero SQLite (relativa a apps/api o absoluta).
DATABASE_PATH=data/portfolio.db

# Orígenes que pueden llamar a la API directamente desde el navegador
# (separados por comas). El frontend en desarrollo vive en el puerto 3000.
CORS_ORIGINS=http://localhost:3000

# Leer la IP real de la cabecera X-Forwarded-For (el frontend hace de proxy).
TRUST_PROXY=true

# Límite de envíos del formulario de contacto por IP.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# Usuario de GitHub con el que se construyen las URLs de los proyectos sembrados.
GITHUB_USER=EasyFeliu
