# Frontend (apps/web). Copia este archivo como `.env.local` si quieres cambiar
# algo: todos los valores tienen un defecto razonable.

# URL del backend a la que Next redirige las peticiones /api/* (lado servidor).
API_URL=http://localhost:4000

# URL pública del sitio; se usa como base de los metadatos Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Déjalo vacío para llamar a la API por el proxy de Next (mismo origen).
# Ponle la URL del backend si prefieres que el navegador la llame directamente
# (entonces recuerda añadir este origen a CORS_ORIGINS en apps/api).
NEXT_PUBLIC_API_BASE_URL=

# Identidad: perfiles y email de contacto que se muestran en la web.
NEXT_PUBLIC_GITHUB_USER=EasyFeliu
NEXT_PUBLIC_LINKEDIN_USER=luisfeliu
NEXT_PUBLIC_CONTACT_EMAIL=hola@luisfeliu.dev
